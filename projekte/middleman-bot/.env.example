# ============================================================================
#  MIDDLEMAN / ESCROW BOT — ENVIRONMENT CONFIGURATION
#  Copy this file to `.env` and fill in your own values.
#  NEVER commit a real `.env` file. NEVER put secrets into source code.
# ============================================================================

# ----------------------------------------------------------------------------
# DISCORD
# ----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Category the private ticket channels are created in (optional).
TICKET_CATEGORY_ID=
# Category tickets are moved to when archived (optional).
TICKET_ARCHIVE_CATEGORY_ID=
# Channel that receives support/admin escalations (disputes, payout reviews).
STAFF_LOG_CHANNEL_ID=

# ----------------------------------------------------------------------------
# ROLES (server-side authorization is checked against these IDs)
# ----------------------------------------------------------------------------
SUPPORT_ROLE_ID=
MIDDLEMAN_ROLE_ID=
ADMIN_ROLE_ID=

# ----------------------------------------------------------------------------
# DATABASE / CACHE
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://middleman:middleman@localhost:5432/middleman?schema=public
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# FEES  (canonical deal value is ALWAYS USD)
# ----------------------------------------------------------------------------
# Default middleman fee in percent. Default: 5 => fee = dealAmountUsd * 0.05
DEFAULT_FEE_PERCENTAGE=5
MIN_DEAL_AMOUNT_USD=5
MAX_DEAL_AMOUNT_USD=100000

# ----------------------------------------------------------------------------
# PRICE PROVIDER
# ----------------------------------------------------------------------------
# mock | coingecko
PRICE_PROVIDER=mock
PRICE_API_KEY=
PRICE_API_BASE_URL=https://api.coingecko.com/api/v3
# How long a price quote stays valid before the buyer must request a new one.
PRICE_QUOTE_TTL_SECONDS=900
PRICE_CACHE_TTL_SECONDS=30

# ----------------------------------------------------------------------------
# BLOCKCHAIN / SAFETY
# ----------------------------------------------------------------------------
# LIVE_MODE=false  => mock/testnet adapters only, mainnet payouts disabled.
# Mainnet is NEVER enabled automatically.
LIVE_MODE=false
# Must be set to the literal string below IN ADDITION to LIVE_MODE=true
# before any mainnet payout can be broadcast.
LIVE_MODE_CONFIRMATION=
# mock | testnet | mainnet
CHAIN_NETWORK_MODE=mock

# Confirmations required before a payment counts as confirmed.
CONFIRMATIONS_BTC=3
CONFIRMATIONS_ETH=12
CONFIRMATIONS_TRON=20

# Node / indexer endpoints (leave blank in mock mode).
BTC_RPC_URL=
EVM_RPC_URL=
TRON_API_URL=

# ----------------------------------------------------------------------------
# WALLET / SIGNING
# ----------------------------------------------------------------------------
# mock | manual  (manual = a human middleman broadcasts and records the tx hash)
# Private keys and seed phrases are NEVER read from the database or from Discord.
SIGNER_BACKEND=mock
# Optional external signer service (HTTP). Used when SIGNER_BACKEND=external.
EXTERNAL_SIGNER_URL=
EXTERNAL_SIGNER_TOKEN=

# ----------------------------------------------------------------------------
# TIMEOUTS / LIFECYCLE
# ----------------------------------------------------------------------------
DEAL_EXPIRY_HOURS=72
PAYMENT_WINDOW_MINUTES=180
TICKET_CLOSE_DELAY_SECONDS=300

# ----------------------------------------------------------------------------
# RUNTIME
# ----------------------------------------------------------------------------
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_PRETTY=true
