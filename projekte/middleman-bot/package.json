{
  "name": "middleman-escrow-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord crypto middleman / escrow bot. Canonical deal value is always USD.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "commands:register": "tsx src/bot/registerCommands.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:esm",
    "verify:esm": "node scripts/verify-esm.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bech32": "^2.0.0",
    "bs58check": "^4.0.0",
    "decimal.js": "^10.4.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "js-sha3": "^0.9.3",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
